# Copy to agents/.env and paste your own keys. agents/.env is gitignored.
# NEVER commit real keys. Nothing in this project prints or logs key values.

# build.nvidia.com -> free developer credits ($0 for the hackathon)
NVIDIA_API_KEY=nvapi-REPLACE_ME

# console.anthropic.com -> pay-as-you-go, separate from a Claude subscription.
# Used only by evals/gen_variants (red-team) and the fallback brain.
# Set a $20 spend limit in the console before using this.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Set to 0 to make live network calls. Default 1 = deterministic offline stubs.
FLOODVR_OFFLINE=1

# LiveKit Cloud (free Build plan) -> voice room "floodvr". Leave empty to use the
# text fallback POST /voice only. Speech-to-text and text-to-speech use NVIDIA
# Riva hosted models with NVIDIA_API_KEY above ($0, developer credits).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
